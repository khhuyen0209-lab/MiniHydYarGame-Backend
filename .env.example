# ============================================================
#  MiniGame HY Backend — Môi trường mẫu
#  Sao chép file này thành .env và điền giá trị thật.
#  Trên Render: điền từng dòng vào phần Environment Variables.
# ============================================================

# --- Server ---
PORT=8080
NODE_ENV=development
# Host công khai của backend (dùng cho log khởi động, health check, link chia sẻ…).
# Mặc định (nếu không set) = https://minihydyargame-backend.onrender.com
# ✅ ĐỔI HOST SAU NÀY: chỉ cần sửa biến này (vd trên Render → Environment Variables),
#    KHÔNG cần đụng vào code. Bỏ dấu / ở cuối.
APP_HOST=https://minihydyargame-backend.onrender.com
# (Tùy chọn) prefix API, mặc định /api/v1
# API_PREFIX=/api/v1
# Cho phép nguồn gốc gọi API (vd: https://minigame-hy.web.app). Dùng * chỉ khi dev.
# LƯU Ý: đây là domain FRONTEND gọi vào backend, KHÔNG phải host của backend.
CORS_ORIGIN=*

# ============================================================
#  Firebase Admin SDK — Service Account
#  Lấy file JSON tại: Firebase Console → Project Settings →
#  Service accounts → Generate new private key.
#
#  CÁCH 1 (khuyến nghị): đặt TỪNG TRƯỜNG của file JSON thành env var.
#  Copy nguyên giá trị từ file JSON vào (private_key dán THẲNG luôn,
#  kể cả có \n — code tự xử lý).
# ============================================================
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=minigame-hy
FIREBASE_PRIVATE_KEY_ID=de98d89933d133e533c4d86e80fc1f6797573300
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTHAY_BẰNG_PRIVATE_KEY_THẬT\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@minigame-hy.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=108127693747669578647
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-fbsvc%40minigame-hy.iam.gserviceaccount.com
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# ============================================================
#  CÁCH 2 (tùy chọn, 1 biến duy nhất — thay thế cho CÁCH 1):
#  Dán TOÀN BỘ nội dung file serviceAccountKey.json vào đây,
#  hoặc encode base64 cả file (code tự nhận diện).
#  Nếu đặt biến này thì KHÔNG cần các biến FIREBASE_* ở trên.
# ============================================================
# FIREBASE_SERVICE_ACCOUNT=

# --- Kinh tế mã mời (số coin thưởng) ---
# Phần thưởng cho NGƯỜI MỜI khi có 1 người nhập mã thành công.
INVITE_REWARD_COINS=100
# Quà chào mừng cho NGƯỜI ĐƯỢC MỜI khi nhập mã thành công.
INVITE_WELCOME_COINS=50
# Thưởng đệ quy CẤP 2: khi người mời (A) cũng từng được mời bởi C,
# thì C nhận thêm coin này mỗi khi A có một lượt mời thành công.
REFERRAL_SECOND_LEVEL_COINS=20
# --- Admin (tạo mã hệ thống PXE/GNTU/HY/ADM + panel quản trị) ---
# Bí mật để gọi API admin qua header x-admin-secret (dành cho script/curl).
# Để trống → chỉ đăng nhập bằng tài khoản admin mới dùng được panel.
ADMIN_SECRET=
# Danh sách email được quyền admin (phân tách bằng dấu phẩy).
# Mặc định đã gồm tài khoản test của chủ dự án: thanhlinh182005@gmail.com
# Quyền admin yêu cầu CẢ email trong danh sách NÀY VÀ users.role==='admin'
# (role chỉ server set được) → không thể giả mạo.
ADMIN_EMAILS=thanhlinh182005@gmail.com
# Khóa mở panel quản trị viên (yếu tố thứ 2, ngoài role admin).
# Client phải gửi header x-admin-panel-key khớp mới gọi được /admin/*.
# Mặc định (nếu không set) = 2306#GNtu_HY (key của nick thanhlinh).
# Để rỗng (ADMIN_PANEL_KEY=) sẽ vô hiệu hóa lớp khóa này (không khuyến nghị).
ADMIN_PANEL_KEY=2306#GNtu_HY
# Thời gian hết hạn trạng thái online (ms). Mặc định 120000 (2 phút).
# ONLINE_TTL_MS=120000
